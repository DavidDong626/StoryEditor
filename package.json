{
  "name": "story-editor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:all": "concurrently -k \"npm run server:dev\" \"npm run dev\"",
    "server:dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "backup": "tsx server/backup.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src server vite.config.ts",
    "format:check": "prettier --check src server vite.config.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vitest": "^5.0.3"
  }
}
